* text=auto eol=lf

# Build scripts and Windows helpers keep their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
gradlew text eol=lf
*.sh text eol=lf

# Data and binaries
*.sqlite binary
*.pack binary
*.png binary
*.jpg binary
*.jpeg binary
*.apk binary
*.so binary
*.dll binary
*.zip binary
*.ico binary
